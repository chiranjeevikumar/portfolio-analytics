# Layerbase PostgreSQL
DATABASE_URL=postgresql://username:password@your-host.cloud.layerbase.dev:5432/dbname?sslmode=require

# JWT Secret (generate a random 32-char string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=portfolio@yourdomain.com
RESEND_FROM_NAME=Portfolio Analytics

# App Settings
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
